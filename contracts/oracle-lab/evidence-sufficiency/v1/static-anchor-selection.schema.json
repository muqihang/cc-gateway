{
  "$defs": {
    "pathDigest": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "pattern": "^capsules/P3B-ES1/control/[A-Za-z0-9._/-]+\\.json$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": ["relative_path", "sha256"],
      "type": "object"
    }
  },
  "$id": "https://cc-gateway.local/oracle-lab/p3b-es/static-anchor-selection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_anchor": { "$ref": "#/$defs/pathDigest" },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "relative_path": { "const": "capsules/P3B-ES1/control/operator-authority.json" },
        "sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
      },
      "required": ["relative_path", "sha256"],
      "type": "object"
    },
    "campaign_id": { "pattern": "^[a-z0-9][a-z0-9-]{7,191}$", "type": "string" },
    "campaign_input": {
      "additionalProperties": false,
      "properties": {
        "relative_path": { "const": "capsules/P3B-ES1/control/campaign-input.json" },
        "sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
      },
      "required": ["relative_path", "sha256"],
      "type": "object"
    },
    "evidence_root_identity": {
      "$ref": "https://cc-gateway.local/oracle-lab/p3b-es/operator-authority.schema.json#/$defs/evidenceRoot"
    },
    "freeze": {
      "additionalProperties": false,
      "properties": {
        "relative_path": { "const": "capsules/P3B-ES1/control/freeze.json" },
        "sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
      },
      "required": ["relative_path", "sha256"],
      "type": "object"
    },
    "raw_material_persisted": { "const": false },
    "receiver_identity": {
      "$ref": "https://cc-gateway.local/oracle-lab/p3b-es/operator-authority.schema.json#/$defs/receiverIdentity"
    },
    "schema_id": { "const": "oracle-lab-p3b-es-static-anchor-selection.v1" },
    "schema_major": { "const": 1 },
    "schema_revision": { "const": 0 },
    "superseded_anchors": {
      "items": { "$ref": "#/$defs/pathDigest" },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_id", "schema_major", "schema_revision", "campaign_id", "evidence_root_identity",
    "authority", "freeze", "campaign_input", "active_anchor", "superseded_anchors",
    "receiver_identity", "raw_material_persisted"
  ],
  "type": "object"
}
